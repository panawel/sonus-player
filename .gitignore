# Packaged app output — .dmg/.zip are ~224MB each and belong on the GitHub
# Releases page, not in the tree. GitHub rejects files over 100MB outright.
release

# Machine-local Claude Code permissions; contains absolute paths from the
# developer's own machine. Note *.local above does NOT match this filename.
.claude/settings.local.json

# Raw full-resolution captures (~27MB). The published, resized and redacted
# versions live in docs/assets/ and are produced by scripts/prepare-screenshots.py.
screenshoots/

